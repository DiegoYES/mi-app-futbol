PORT=3000
NODE_ENV=production
# Número exacto de proxies delante de Express. 1 para Nginx/Caddy en la misma VM.
TRUST_PROXY=1
# Origen público, sin slash final. Acepta varios separados por coma.
APP_ORIGIN=https://futbol.example.com
JSON_BODY_LIMIT=32kb
API_RATE_LIMIT_PER_MINUTE=240
USER_RATE_LIMIT_PER_MINUTE=120
CACHE_MAX_KEYS=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mi-app-futbol
API_FOOTBALL_KEY=tu_api_key
API_FOOTBALL_KEY_2=tu_api_key_respaldo
# Solo para claves redundantes autorizadas del mismo proyecto/equipo; no suma cuota diaria.
API_FOOTBALL_ALLOW_KEY_FAILOVER=false
# Opcional: lista explícita de claves redundantes.
# API_FOOTBALL_KEYS=clave_1,clave_2,clave_3
API_FOOTBALL_DAILY_LIMIT=7500
# 0 aprovecha todo el cupo reportado; súbelo solo si quieres reservar llamadas manuales.
API_FOOTBALL_QUOTA_MARGIN=0
API_FOOTBALL_QUOTA_TIMEZONE=UTC
# Pro permite 5/s y 300/min; 4/s deja margen y equivale a 240/min por worker.
API_FOOTBALL_MAX_RPS=4
API_FOOTBALL_MAX_RETRIES=2
API_FOOTBALL_CIRCUIT_FAILURES=5
API_FOOTBALL_CIRCUIT_COOLDOWN_MS=30000
FOOTBALL_SEASON=2026
# El comparador/picks sólo ofrece esta temporada API y posteriores; el archivo sigue disponible para historiales.
ANALYSIS_MIN_SEASON=2025
# Prioridad: Liga MX, MLS, Brasileirão, Premier, LaLiga, Ligue 1, Serie A y Bundesliga.
SYNC_LEAGUES=262,253,71,39,140,61,135,78
# Solo para reintentar huecos ya consultados que el proveedor dejó vacíos.
SYNC_RETRY_GAPS=false
# Lease compartido en MongoDB para impedir cron duplicado entre instancias.
SYNC_LOCK_LEASE_MS=120000
JWT_SECRET=reemplaza_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRA=7d

# Mercado Pago Suscripciones. Nunca subas credenciales reales al repositorio.
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_PUBLIC_KEY=tu_public_key_de_prueba
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_prueba
MERCADOPAGO_WEBHOOK_SECRET=se_genera_al_configurar_webhooks

# Mercados públicos de Playdoit (sin claves ni credenciales)
PLAYDOIT_BASE_URL=https://www.playdoit.mx/betting-games
PLAYDOIT_HEADLESS=true
PLAYDOIT_TIMEOUT_MS=30000
PLAYDOIT_INSPECTION_MS=90000
PLAYDOIT_MAX_RETRIES=2
# Opcional: reutiliza una captura sanitizada creada con markets:inspect.
# PLAYDOIT_CAPTURE_FILE=var/playdoit/captura.json
MARKET_CACHE_TTL_MINUTES=10
MIN_EDGE=0.05
MIN_EXPECTED_VALUE=0.03
MODEL_MIN_SAMPLE=5
MARKET_REFRESH_ENABLED=false
# Reservado para un scheduler local futuro; la app no instala tareas automáticamente.
MARKET_REFRESH_CRON=*/15 * * * *
