# Plantilla de entorno para STAGING (staging.data-fut.com).
# FASE 1 (PM2): copia este archivo a /var/www/mi-app-futbol-staging/.env
# (permisos 600). La app lo carga con dotenv; deploy-staging.sh valida que
# PORT, MONGODB_URI y APP_ENVIRONMENT sean los de staging antes de arrancar.
# NUNCA lo copies con valores reales al repositorio ni reutilices secretos de
# producción.

# production a propósito: staging debe probar cookies Secure, HSTS y CSP reales.
NODE_ENV=production
# Marca lógica del entorno: activa el banner "ENTORNO DE PRUEBA".
APP_ENVIRONMENT=staging

PORT=3100
HOST=127.0.0.1
TRUST_PROXY=1
APP_ORIGIN=https://staging.data-fut.com

JSON_BODY_LIMIT=32kb
API_RATE_LIMIT_PER_MINUTE=240
USER_RATE_LIMIT_PER_MINUTE=120
CACHE_MAX_KEYS=5000

# Base de datos EXCLUSIVA de staging. Jamás apuntes a la base de producción
# (mi-app-futbol). El sufijo -staging es obligatorio: los scripts de semillas
# se niegan a ejecutarse contra cualquier base que no termine en -staging.
MONGODB_URI=mongodb://127.0.0.1:27017/mi-app-futbol-staging

# Secreto propio de staging. Genera uno nuevo con: openssl rand -base64 48
# NUNCA reutilices el JWT_SECRET de producción.
JWT_SECRET=genera_un_secreto_distinto_al_de_produccion
JWT_EXPIRA=7d

# --- API-Football DESHABILITADA en staging ---
# Staging no debe consumir cuota real. Deja la clave vacía: los workers de
# sincronización fallarán de inmediato si alguien intenta ejecutarlos.
API_FOOTBALL_KEY=
API_FOOTBALL_ALLOW_KEY_FAILOVER=false
API_FOOTBALL_DAILY_LIMIT=0

# --- Sincronizaciones y cron DESHABILITADOS ---
# Staging no ejecuta cron, workers, Playdoit ni actualizaciones de mercados.
SYNC_RETRY_GAPS=false
MARKET_REFRESH_ENABLED=false
PLAYDOIT_HEADLESS=true

FOOTBALL_SEASON=2026
ANALYSIS_MIN_SEASON=2025
