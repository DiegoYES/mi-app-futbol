# Configuración no secreta consumida por promote-production.sh y
# rollback-production.sh después de activar el pool.
PROD_SERVICES="mi-app-futbol mi-app-futbol-secondary"
PROD_PORTS="3000 3001"
PROD_UNIT_PATHS="/etc/systemd/system/mi-app-futbol.service /etc/systemd/system/mi-app-futbol-secondary.service"
# El upstream usa fail_timeout=10s; deja que Nginx vuelva a considerar sana una
# instancia antes de reiniciar la siguiente.
POOL_SETTLE_SECONDS=11
