# Servicio systemd de producción — FASE 2 (migración PM2 -> systemd).
# En la fase actual producción corre bajo PM2 (proceso futbol-app). Esta
# plantilla la instala deploy/migrate-production-systemd.sh durante la
# ventana de mantenimiento autorizada; no la instales a mano.

[Unit]
Description=Mi App Futbol
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=miappfutbol
Group=miappfutbol
# Ejecuta desde el symlink current: /opt/mi-app-futbol/current -> releases/<sha>,
# creado por deploy/migrate-production-systemd.sh durante la migración.
WorkingDirectory=/opt/mi-app-futbol/current
EnvironmentFile=/etc/mi-app-futbol/app.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mi-app-futbol/current/var
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
