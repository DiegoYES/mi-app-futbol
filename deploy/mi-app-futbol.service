[Unit]
Description=Mi App Futbol
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=miappfutbol
Group=miappfutbol
# El flujo de despliegue por releases (deploy/promote-production.sh) exige
# ejecutar desde el symlink current: /opt/mi-app-futbol/current -> releases/<sha>.
# Si tu instalación aún usa /opt/mi-app-futbol plano, migra el unit real a
# esta plantilla antes de usar promote/rollback (ver docs/STAGING.md).
WorkingDirectory=/opt/mi-app-futbol/current
EnvironmentFile=/etc/mi-app-futbol/app.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mi-app-futbol/current/var
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
