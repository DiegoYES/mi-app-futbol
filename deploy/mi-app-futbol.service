[Unit]
Description=Mi App Futbol
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=miappfutbol
Group=miappfutbol
WorkingDirectory=/opt/mi-app-futbol
EnvironmentFile=/etc/mi-app-futbol/app.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mi-app-futbol/var
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
